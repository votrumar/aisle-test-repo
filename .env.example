# Override when running outside docker-compose.
# Inside docker-compose the api service points at the `db` service automatically.
DATABASE_URL=postgresql+psycopg://monitoring:monitoring@localhost:5432/monitoring
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fernet key used to encrypt stored remote sensor SSH keys at rest.
REMOTE_SENSOR_KEY_ENCRYPTION_SECRET=CHANGE_ME_GENERATE_A_UNIQUE_FERNET_KEY
