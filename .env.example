# Override when running outside docker-compose.
# Inside docker-compose the api service points at the `db` service automatically.
DATABASE_URL=postgresql+psycopg://monitoring:monitoring@localhost:5432/monitoring

# Secret used to validate bearer JWTs protecting /admin/* endpoints.
# Must be >= 32 chars and not a placeholder.
# Generate one, for example:
#   openssl rand -hex 32
# MONITORING_AUTH_SECRET=
